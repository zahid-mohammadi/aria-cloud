{
  "name": "@aria-cloud/auth",
  "version": "1.0.0",
  "private": true,
  "description": "Email + password authentication: scrypt hashing, sessions, login lockout",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "create-user": "node scripts/create-user.mjs"
  },
  "dependencies": {
    "@aria-cloud/database": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
