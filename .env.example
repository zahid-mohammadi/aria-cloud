# ====================================================================
# ARIA CLOUD SERVICES & ARIA AI STUDIO - ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. AWS Regions & Infrastructure
AWS_REGION="me-central-1"
BEDROCK_REGION="us-east-1"
NOVA_MICRO_PROFILE_ID="amazon.nova-micro-v1:0"
NOVA_LITE_PROFILE_ID="amazon.nova-lite-v1:0"
NOVA_CANVAS_MODEL_ID="amazon.nova-canvas-v1:0"
PUBLIC_ASSETS_BUCKET="aria-tenants-public-assets"
CLOUDFRONT_DOMAIN="cdn.ariacloud.af"

# 2. PostgreSQL Multi-Tenant Database (Non-Superuser RLS Role)
DATABASE_URL="postgresql://aria_app_user:CHANGE_ME@localhost:5432/aria_cloud"
DATABASE_CONNECTION_STRING="postgresql://aria_app_user:CHANGE_ME@localhost:5432/aria_cloud"

# 3. ElevenLabs Multimodal Voice Engine (33M Annual Credit Pool)
ELEVENLABS_API_KEY="xi-api-key-change-me"

# 4. HesabPay Domestic Payment Gateway
HESABPAY_SECRET_KEY="hesabpay-webhook-hmac-secret-change-me"
HESABPAY_MERCHANT_ID="aria-cloud-af"

# 5. Meta WhatsApp Cloud API
META_PHONE_ID="100000000000000"
META_ACCESS_TOKEN="EAAB-change-me"
META_VERIFY_TOKEN="aria-whatsapp-webhook-verify-token"
