# ============================================================================
# AriaCloud — Afghan Digital Enablement Initiative
# Canonical Environment Configuration (.env.example / .env.production)
# Root Domain: ariacloudservices.org | Primary Region: me-central-1 (UAE)
# ============================================================================

# --- Domain & Routing ---
NEXT_PUBLIC_ROOT_DOMAIN="ariacloudservices.org"
NEXT_PUBLIC_APP_URL="https://app.ariacloudservices.org"
NEXT_PUBLIC_API_URL="https://api.ariacloudservices.org"
NEXT_PUBLIC_APP_NAME="AriaCloud"
MERCHANT_WILDCARD_DOMAIN="*.ariacloudservices.org"

# --- Email & Identities ---
SUPPORT_EMAIL="support@ariacloudservices.org"
SYSTEM_FROM_EMAIL="no-reply@ariacloudservices.org"
POSTMASTER_EMAIL="postmaster@ariacloudservices.org"
MAIL_SERVER_HOSTNAME="mail.ariacloudservices.org"
SES_REGION="me-central-1"
SES_INBOUND_REGION="eu-west-1"

# --- Storage & CDN ---
PUBLIC_ASSETS_BUCKET="ariacloud-public-assets"
STUDIO_MEDIA_BUCKET="aria-studio-media-me-central-1"
CLOUDFRONT_DOMAIN="cdn.ariacloudservices.org"

# --- AI Assistant Context ---
SYSTEM_AI_NAME="Aria Assistant"
ORGANIZATION_MISSION="AriaCloud — Afghan Digital Enablement Initiative"

# --- AWS Regional Topology ---
AWS_REGION="me-central-1"
BEDROCK_REGION="us-east-1"

# --- PostgreSQL (Aurora Serverless v2 with Row-Level Security) ---
DATABASE_URL="postgresql://aria_app:CHANGE_ME@localhost:5432/aria_cloud?sslmode=require"

# --- Pillar VII: ElevenLabs (33M Credit Pool) ---
ELEVENLABS_API_KEY="xi-api-key-change-me"
ELEVENLABS_DEFAULT_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# --- Pillar VI: Financial Settlement & WhatsApp Cloud API ---
HESABPAY_WEBHOOK_SECRET="whsec_change_me"
WHATSAPP_API_URL="https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_ACCESS_TOKEN="EAAG_change_me"
WHATSAPP_VERIFY_TOKEN="aria_whatsapp_verify_token"
